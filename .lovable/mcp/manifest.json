{
  "version": 1,
  "sdk_version": "2.0.4",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://qjhdycpkguutiunxtpvt.supabase.co/auth/v1",
    "accepted_audiences": ["authenticated"]
  },
  "mcp": {
    "server": {
      "name": "word-keeper-pro",
      "version": "1.0.0",
      "title": "Word Keeper Pro"
    },
    "tools": [
      {
        "name": "list_lists",
        "title": "List word lists",
        "description": "List the signed-in user's word lists, with how many saved words each one holds.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "create_list",
        "title": "Create word list",
        "description": "Create a new word list for the signed-in user.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60,
              "description": "Name of the new list."
            }
          },
          "required": ["name"]
        },
        "outputSchema": null
      },
      {
        "name": "rename_list",
        "title": "Rename word list",
        "description": "Rename one of the signed-in user's word lists.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "The list id."
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60,
              "description": "The new name."
            }
          },
          "required": ["id", "name"]
        },
        "outputSchema": null
      },
      {
        "name": "delete_list",
        "title": "Delete word list",
        "description": "Delete a word list. Words that belonged only to it become unreachable.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "idempotentHint": true
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "The list id."
            }
          },
          "required": ["id"]
        },
        "outputSchema": null
      },
      {
        "name": "list_words",
        "title": "List saved words",
        "description": "List saved words, optionally filtered by list, tag, or a text search.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "listId": {
              "description": "Only return words saved in this list.",
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "tag": {
              "description": "Only return words with this tag.",
              "type": "string"
            },
            "q": {
              "description": "Text to search for in the headword or note.",
              "type": "string"
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "save_word",
        "title": "Save word",
        "description": "Save a word to one or more of the signed-in user's lists, with an optional note and tags. A word is unique per user, so an existing word is updated and added to any new lists.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "listIds": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "description": "The list(s) to save the word into."
            },
            "headword": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "description": "The word being saved."
            },
            "note": {
              "description": "Optional personal note.",
              "type": "string",
              "maxLength": 4000
            },
            "tags": {
              "description": "Optional tags.",
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": ["listIds", "headword"]
        },
        "outputSchema": null
      },
      {
        "name": "update_word",
        "title": "Update saved word",
        "description": "Update the note or tags of a saved word, and/or add or remove it from lists. Removing its last list deletes the word.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "The saved word id."
            },
            "note": {
              "description": "New note text.",
              "type": "string",
              "maxLength": 4000
            },
            "tags": {
              "description": "New tags (replaces existing tags).",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "addListIds": {
              "description": "List ids to add this word to.",
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              }
            },
            "removeListIds": {
              "description": "List ids to remove this word from.",
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              }
            }
          },
          "required": ["id"]
        },
        "outputSchema": null
      },
      {
        "name": "delete_word",
        "title": "Delete saved word",
        "description": "Remove a saved word. With listId, only removes it from that list (deleting it entirely if it was the last one); otherwise deletes it everywhere.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "idempotentHint": true
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "The saved word id."
            },
            "listId": {
              "description": "Only remove the word from this list.",
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "required": ["id"]
        },
        "outputSchema": null
      }
    ]
  }
}
